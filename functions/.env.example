ADMIN_EMAILS=admin@example.com

# Comma-separated list of browser origins allowed to call this API.
#
# The Android app does NOT need an entry here. CORS is enforced by browsers
# only; a native app sends no Origin header, so the release APK is unaffected.
#
# The only browser client is the /admin panel, part of the Expo web build,
# which today is served solely by the Expo web dev server. Add the real admin
# URL here as well once /admin is actually hosted somewhere.
#
# NOTE: api_fn in main.py also declares CorsOptions(cors_origins="*") at the
# Cloud Functions layer, which handles preflight before FastAPI sees it. Both
# that and this value need narrowing for the restriction to take effect, and
# changing either requires redeploying the function.
ADMIN_ALLOWED_ORIGINS=http://localhost:8081
