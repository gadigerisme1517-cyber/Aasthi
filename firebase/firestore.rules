rules_version = '2';

// ============================================================================
// AASTHI — Firestore security rules (PRODUCTION)
// ----------------------------------------------------------------------------
// Replaces the open dev rules (allow read, write: if true). Admin reads/writes
// (verification approvals, listing approvals, bug report triage) go through
// the api_fn Cloud Function (functions/) using the Firebase Admin SDK, which
// bypasses these rules
// entirely — locking this down does not break /admin.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Public seller directory — managed by seed script / admin only.
    match /sellers/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Listings: public read, owner-scoped write.
    match /listings/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.sellerUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.sellerUid == request.auth.uid;
    }

    // Per-user private profile/settings.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Leads: buyers create, nobody reads directly from the client
    // (sellers see their leads via notifications; admin uses Admin SDK).
    match /leads/{id} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    // Notifications: created for another user (e.g. seller notified of a
    // buyer's enquiry), so create isn't owner-scoped — only the recipient
    // can read their own notifications.
    match /notifications/{id} {
      allow create: if signedIn();
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Bug reports: write-only from the client; admin reads via Admin SDK.
    match /bugReports/{id} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    // Seller verification submissions: owner creates, nobody reads from the
    // client (contains sensitive ID/ownership doc URLs); admin uses Admin SDK.
    match /verificationRequests/{id} {
      allow create: if signedIn() && request.resource.data.sellerUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
