rules_version = '2';

// ============================================================================
// AASTHI — Firestore security rules (PRODUCTION)
// ----------------------------------------------------------------------------
// Replaces the open dev rules (allow read, write: if true). Admin reads/writes
// (verification approvals, listing approvals, bug report triage) go through
// the api_fn Cloud Function (functions/) using the Firebase Admin SDK, which
// bypasses these rules
// entirely — locking this down does not break /admin.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Public seller directory — managed by seed script / admin only.
    match /sellers/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Listings: public read, owner-scoped write, plus ONE narrow exception.
    //
    // The exception is the view counter. A view is by definition recorded by
    // someone who is NOT the owner, so it cannot live behind the owner check.
    // It is scoped as tightly as the rules language allows: a signed-in
    // non-owner may change `views` AND NOTHING ELSE, and may only move it up
    // by exactly one. They cannot set it to an arbitrary number, cannot
    // decrement it, and cannot smuggle any other field along with it.
    // get('views', 0) covers listings published before the field existed.
    match /listings/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.sellerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.sellerUid == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.sellerUid == request.auth.uid ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
          request.resource.data.views == resource.data.get('views', 0) + 1
        )
      );
    }

    // Per-user private profile/settings.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Leads: buyers create; the two parties to a lead can read it.
    //
    // The seller read is what makes /my-enquiries possible — before this,
    // read was denied to everyone and a lead was written to a collection
    // nothing could ever query, so an enquiry reached no one.
    //
    // The buyer read is narrower in purpose: /detail only reveals a seller's
    // phone number to a buyer who has already enquired, and that check needs
    // the buyer to see their own leads. It exposes nothing the buyer did not
    // write themselves.
    //
    // update and delete stay denied for BOTH sides: a lead is an immutable
    // record of contact, and neither party may rewrite or erase it.
    match /leads/{id} {
      allow create: if signedIn();
      allow read: if signedIn() && (
        resource.data.sellerUid == request.auth.uid ||
        resource.data.buyerUid == request.auth.uid
      );
      allow update, delete: if false;
    }

    // Lead replies: the "this one was answered" stamp.
    //
    // It is a SEPARATE collection because a lead is immutable above and stays
    // that way — an agent must not be able to edit the record of what a buyer
    // asked just to mark it handled. The document id IS the lead id, so there
    // is exactly one stamp per lead and a second tap overwrites rather than
    // accumulates.
    //
    // The get() proves the writer is the seller ON THAT LEAD, not merely a
    // signed-in user naming themselves in the payload. One get per write, on a
    // single-document write, so nowhere near the call budget. Reading is the
    // seller's only — nothing surfaces reply time to buyers yet, and opening
    // that up is a product decision, not a side effect of recording it.
    match /leadReplies/{leadId} {
      allow read: if signedIn() && resource.data.sellerUid == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.sellerUid == request.auth.uid
        && get(/databases/$(database)/documents/leads/$(leadId)).data.get('sellerUid', '') == request.auth.uid;
      allow delete: if false;
    }

    // Thread messages: the conversation on one lead.
    //
    // A SUBCOLLECTION so the lead id is in the PATH. The rule reads it from
    // there instead of trusting a field, so a sender cannot post into someone
    // else's thread by writing a different leadId in the payload. Every
    // document in one thread also resolves the SAME get(), which Firestore
    // caches per request, so reading a whole thread costs one document access
    // call rather than one per message.
    //
    // Both parties to the lead may read and write. Nobody else, including the
    // other side's future self: revoking is a matter of deleting the lead,
    // which nothing can do.
    //
    // Immutable once sent, for exactly the reason a lead is immutable: a
    // record of what was said must not be editable by the person who said it.
    // The phone-number filter runs on the client (src/lib/phone-filter.ts);
    // rules cannot inspect a string that closely, which is why this is
    // friction rather than enforcement.
    match /messages/{leadId}/items/{messageId} {
      function lead() {
        return get(/databases/$(database)/documents/leads/$(leadId)).data;
      }
      function party() {
        return signedIn() && (
          lead().get('sellerUid', '') == request.auth.uid ||
          lead().get('buyerUid', '') == request.auth.uid
        );
      }
      allow read: if party();
      allow create: if party()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.leadId == leadId
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
      allow update, delete: if false;
    }

    // Notifications: created for another user (e.g. seller notified of a
    // buyer's enquiry), so create isn't owner-scoped — only the recipient
    // can read their own notifications.
    match /notifications/{id} {
      allow create: if signedIn();
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Bug reports: write-only from the client; admin reads via Admin SDK.
    match /bugReports/{id} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }

    // Seller verification submissions: owner creates, nobody reads from the
    // client (contains sensitive ID/ownership doc URLs); admin uses Admin SDK.
    match /verificationRequests/{id} {
      allow create: if signedIn() && request.resource.data.sellerUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
