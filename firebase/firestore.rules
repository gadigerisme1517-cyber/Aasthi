rules_version = '2';

// ============================================================================
// AASTHI — Firestore security rules
// ----------------------------------------------------------------------------
// CURRENT (development) rules — OPEN. This is what the project uses today so the
// app + seed script work without friction. DO NOT ship this to production.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

