rules_version = '2';

// ============================================================================
// AASTHI — Firebase Storage security rules (PRODUCTION)
// ----------------------------------------------------------------------------
// Replaces the open dev rules (allow read, write: if true).
// Upload paths used by the app:
//   listings/{uid}/...       (property photos, set in src/services/db.ts)
//   verifications/{uid}/...  (Govt ID + ownership proof, set in app/verify.tsx)
// ============================================================================
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }

    // Listing photos: public read (shown in the app), owner-only write.
    match /listings/{uid}/{file=**} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Verification docs (Govt ID, ownership proof): private. Only the owner
    // can write; nobody reads from the client — admin reads via Admin SDK.
    match /verifications/{uid}/{file=**} {
      allow read: if false;
      allow write: if signedIn() && request.auth.uid == uid
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
