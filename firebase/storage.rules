rules_version = '2';

// ============================================================================
// AASTHI — Firebase Storage security rules
// ----------------------------------------------------------------------------
// CURRENT (development) rules — OPEN. DO NOT ship to production.
// Uploads used by the app:
//   listings/{uid}/...       (property photos)
//   verifications/{uid}/...  (Govt ID + ownership proof)
// ============================================================================
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}

