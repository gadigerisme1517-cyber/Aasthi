# ---- AASTHI frontend environment (Expo) ----
# Copy this file to `.env` and fill in the values. Only EXPO_PUBLIC_* vars are
# exposed to the app bundle. The Firebase WEB config below is SAFE to be public
# (Firebase secures data with Auth + security rules, not by hiding these).

# Backend base URL (FastAPI). For local dev this is your machine's backend.
EXPO_PUBLIC_BACKEND_URL=https://us-central1-aasthi-3a009.cloudfunctions.net/api_fn

# ---- Firebase Web (client) config — safe public values for project aasthi-3a009 ----
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyCVvoZlQRzUlk9y2KUJ0D_jIJMHdvIDvAo
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=aasthi-3a009.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=aasthi-3a009
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=aasthi-3a009.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MSG_SENDER_ID=58983588171
EXPO_PUBLIC_FIREBASE_APP_ID=1:58983588171:android:832e55035052c6cc98c8ce

# ---- Optional: native Google Sign-In (only needed for a native build) ----
# Obtain a "Web application" OAuth 2.0 Client ID in Google Cloud Console.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# ---- Hosted-preview only (NOT needed for local dev) ----
# These are injected automatically by the Emergent preview environment.
# EXPO_TUNNEL_SUBDOMAIN=
# EXPO_PACKAGER_HOSTNAME=
# EXPO_PACKAGER_PROXY_URL=
# EXPO_USE_FAST_RESOLVER=1
