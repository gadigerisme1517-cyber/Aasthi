# ---- AASTHI backend environment (FastAPI) ----
# Copy this file to `.env` and fill in the values. NEVER commit the real .env.

# Firebase Admin SDK service account, base64-encoded.
# Generate the JSON at: Firebase Console -> Project settings -> Service accounts
# -> "Generate new private key". Then:
#   Linux/macOS:  base64 -w0 service-account.json
#   Windows PS :  [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
# Paste the single-line result here. KEEP THIS SECRET.
FIREBASE_ADMIN_CREDENTIALS_B64=

# Comma-separated list of admin emails allowed into /admin and /api/admin/*.
# Admins authenticate with their own Firebase account (Google or email/password).
ADMIN_EMAILS=

# Comma-separated list of browser origins allowed to call this API.
#
# The Android app does NOT need an entry here. CORS is enforced by browsers
# only; a native app sends no Origin header, so the release APK is unaffected
# by whatever this is set to.
#
# The only browser client is the /admin panel (frontend/app/admin/index.tsx),
# which is part of the Expo web build. Today that is served solely by the Expo
# web dev server, so the dev origin below is all that is required. Add the real
# admin URL here as well once /admin is actually hosted somewhere.
#
# Leave unset only for throwaway local work — it falls back to "*" with a warning.
ADMIN_ALLOWED_ORIGINS=http://localhost:8081
