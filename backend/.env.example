# ---- AASTHI backend environment (FastAPI) ----
# Copy this file to `.env` and fill in the values. NEVER commit the real .env.

# Firebase Admin SDK service account, base64-encoded.
# Generate the JSON at: Firebase Console -> Project settings -> Service accounts
# -> "Generate new private key". Then:
#   Linux/macOS:  base64 -w0 service-account.json
#   Windows PS :  [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
# Paste the single-line result here. KEEP THIS SECRET.
FIREBASE_ADMIN_CREDENTIALS_B64=

# Comma-separated list of admin emails allowed into /admin and /api/admin/*.
# Admins authenticate with their own Firebase account (Google or email/password).
ADMIN_EMAILS=gadiger14@gmail.com

# Comma-separated list of origins allowed to call this API from a browser
# (your deployed /admin panel's URL, e.g. https://admin.aasthi.app).
# Leave unset only for local dev — falls back to "*" with a warning.
ADMIN_ALLOWED_ORIGINS=
